{
  "name": "@adobe/aem-boilerplate",
  "private": true,
  "version": "1.3.0",
  "description": "Starter project for Adobe Helix",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "build:tokens": "node tools/scripts/sync-design-tokens.mjs",
    "check:token-collisions": "node tools/scripts/check-token-collisions.mjs",
    "check:size-budget": "node tools/scripts/check-file-size-budget.mjs",
    "check:lighthouse": "node tools/scripts/generate-lighthouserc.mjs && npx --yes @lhci/cli@0.15.x autorun --config=./lighthouserc.generated.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-boilerplate.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/aem-boilerplate/issues"
  },
  "homepage": "https://github.com/adobe/aem-boilerplate#readme",
  "devDependencies": {
    "@audemarspiguet/design-tokens": "1.0.7-adobe-demo.2",
    "@babel/eslint-parser": "7.28.5",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "^29.1.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "39.0.1",
    "vitest": "^4.1.11"
  }
}
